# =============================================================================
# KALEM Orkestrasyon Katmanı — Ortam Değişkenleri
# =============================================================================

# --- Sunucu ---
PORT=3000
NODE_ENV=development

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/kalem

# --- Stellar Ağ Ayarları ---
# Testnet veya Pubnet (PoC aşamasında "testnet")
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# --- Deploy Edilmiş Kontrat ID'leri ---
DTL_TOKEN_CONTRACT_ID=
POOL_MANAGER_CONTRACT_ID=

# --- Havuz Adresleri ---
# Havuz 1 (Likidite) — Soroban adresi
POOL1_ADDRESS=
# Havuz 2 (Gaz Sponsor) — Klasik Stellar hesabı (G... adresi)
POOL2_ADDRESS=
# Havuz 3 (Sosyal Destek) — Soroban adresi
POOL3_ADDRESS=
# Havuz 4 (Operasyonel Gelir) — Soroban adresi
POOL4_ADDRESS=

# --- Havuz 2 Gizli Anahtarı ---
# Fee-Bump dış zarf imzalama için. ÜRETİMDE HSM KULLANILACAK.
# DİKKAT: Bu anahtar yalnızca XLM içeren Gaz Sponsor havuzuna aittir.
POOL2_SECRET_KEY=

# --- İhraççı (Admin) Gizli Anahtarı ---
# Mint/burn işlemleri için. ÜRETİMDE HSM KULLANILACAK.
ISSUER_SECRET_KEY=

# --- AES-256 Şifreleme ---
# MongoDB'deki mali verilerin şifrelenmesi için.
AES_ENCRYPTION_KEY=

# --- Demo Musluk (Faucet) — YALNIZCA testnet, gerçek bir PSP tahsilatının yerini tutar ---
# Her istekte mint edilecek sabit tutar (stroop). 100000000 = 10 dTL.
FAUCET_MINT_AMOUNT_STROOPS=100000000

# --- CORS ---
# Herhangi bir localhost/127.0.0.1 portuna zaten her zaman izin verilir (dev).
# Prod/demo sunucu adresi netleşince buraya virgülle ayrılmış TAM origin
# listesi eklenmelidir (örn. https://kalem-client.example.com).
CORS_ALLOWED_ORIGINS=

# --- Havuz 2 Besleme Eşiği ---
# XLM cinsinden. Bu değerin altına düşünce cron job tetiklenir.
POOL2_XLM_THRESHOLD=10

# --- Demo Modu (TEKNOFEST sunumu için) ---
# false (varsayılan): Havuz 4 -> Havuz 2 besleme akışında off-chain XLM
#   temini MANUEL onay bekler ("awaiting_offchain" kuyruğu). Gerçekçi/
#   üretim davranışı.
# true: POOL_FEEDER_DEMO_DTL_PER_XLM ile sabit bir kur kullanılarak XLM
#   enjeksiyonu OTOMATİK yapılır (loglarda "SİMÜLE KUR" damgasıyla).
#   Yalnızca canlı demo/sunum için.
DEMO_MODE=false

# --- Fee-Bump (Dış Zarf) Ayarları ---
# İç zarfın inclusion fee'sine uygulanan marj katsayısı (surge pricing tamponu).
FEE_BUMP_BASE_FEE_MULTIPLIER=2
# baseFee için üst sınır (stroops).
FEE_BUMP_MAX_BASE_FEE_STROOPS=100000
# Dış zarfın TOPLAM ücreti için mutlak tavan (stroops, ~1 XLM).
FEE_BUMP_MAX_TOTAL_FEE_STROOPS=10000000
# İç zarfta izin verilen maksimum operasyon sayısı.
FEE_BUMP_MAX_INNER_OPERATIONS=1
# Sponsorlanabilecek kontrat ID'leri (virgülle ayrılmış). Boş bırakılırsa
# DTL_TOKEN_CONTRACT_ID + POOL_MANAGER_CONTRACT_ID otomatik kullanılır.
FEE_BUMP_ALLOWED_CONTRACT_IDS=
# İç zarfın sonlu bir maxTime (timebounds) taşımasını zorunlu kılar.
FEE_BUMP_REQUIRE_TIMEBOUNDS=false

# --- Havuz 4 -> Havuz 2 Besleme (Pool Feeder) Ayarları ---
POOL_FEEDER_CRON=*/5 * * * *
# true: Havuz 2 bakiyesi minimum rezerv/liabilities düşülerek (harcanabilir) hesaplanır.
POOL_FEEDER_USE_SPENDABLE_BALANCE=true
# Bu tutarın altındaki Havuz 4 bakiyeleri için besleme döngüsü tetiklenmez (stroops).
POOL_FEEDER_MIN_BURN_STROOPS=10000000
# Tek bir döngüde en fazla yakılacak tutar (stroops).
POOL_FEEDER_MAX_BURN_STROOPS=1000000000
# DEMO_MODE=true iken kullanılan sabit dTL/XLM kuru. DEMO_MODE=false iken kullanılmaz.
POOL_FEEDER_DEMO_DTL_PER_XLM=
